{
  "id": "complete-example",
  "name": "Complete Tileflow modules example",
  "version": 1,
  "root": {"compiler": "streets", "compilerVersion": 1},
  "glyphs": {
    "kind": "url",
    "url": "https://cdn.example.com/glyphs/v1/{fontstack}/{range}.pbf",
    "fontStacks": ["Noto Sans Regular", "Noto Sans Bold"]
  },
  "data": {
    "type": "vector-tiles",
    "attribution": "© OpenMapTiles © OpenStreetMap contributors",
    "url": "https://example.com/tiles.json",
    "schema": {
      "type": "openmaptiles",
      "contractVersion": 1,
      "layers": {
        "bathymetry": "bathymetry",
        "businessCorridor": "business_corridor",
        "circularFeature": "circular_feature",
        "globalLandcover": "globallandcover",
        "sidewalk": "sidewalk",
        "streetFurniture": "street_furniture",
        "tree": "tree"
      },
      "fields": {
        "bathymetryMinDepth": "min_depth",
        "bathymetrySortKey": "sort_key",
        "circularInnerRadiusMeters": "inner_radius_m",
        "circularKind": "circle_kind",
        "circularOuterRadiusMeters": "outer_radius_m",
        "circularRadiusAtZoom15": "radius_px_z15",
        "circularRadiusMeters": "radius_m",
        "direction": "direction"
      }
    }
  },
  "theme": {"mode": "light"},
  "projection": "globe",
  "terrain": "none",
  "view": {
    "center": [-3.7038, 40.4168],
    "zoom": 13,
    "pitch": 35,
    "bearing": 0
  },
  "scenes": {
    "madrid-desktop": {
      "camera": {"type": "center", "center": [-3.7038, 40.4168], "zoom": 13},
      "viewport": {"width": 1280, "height": 800, "dpr": 1}
    }
  },
  "modules": {
    "addresses": {
      "type": "addresses",
      "labels": {
        "minZoom": 17,
        "text": {"color": "#455468", "size": 11, "haloColor": "#FFFFFF", "haloWidth": 1}
      }
    },
    "aeroways": {
      "type": "aeroways",
      "area": {"fill": {"color": "#E8EBEF"}},
      "runway": {
        "casing": {"color": "#CAD0D7", "width": 8},
        "fill": {"color": "#FFFFFF", "width": 6}
      },
      "taxiway": {"fill": {"color": "#D7DDE3", "width": 2}},
      "runwayRef": {"text": {"color": "#455468", "size": 11}}
    },
    "boundaries": {
      "type": "boundaries",
      "admin2": {"color": "#98A4AF", "width": 1.2},
      "admin4": {"color": "#B5BEC7", "width": 0.8},
      "disputed": {"color": "#C77878", "dash": [3, 2]},
      "maritime": {"color": "#7FAFC5", "dash": [2, 2]}
    },
    "buildings": {
      "type": "buildings",
      "mode": "3d",
      "businessCorridor": {"fill": {"color": "#F3E8D0", "opacity": 0.55}},
      "flat": {
        "fill": {"color": "#E2E5E9"},
        "outline": {"color": "#C8CDD3", "width": 0.6}
      },
      "extrusion": {"color": "#D8DCE1", "opacity": 0.9, "verticalGradient": true}
    },
    "labels": {
      "type": "labels",
      "language": "auto",
      "places": "all",
      "roads": "streets",
      "shields": "major",
      "water": "all",
      "aerodromeCodes": "iata",
      "junctions": true,
      "styles": {
        "places": {
          "city": {
            "text": {"color": "#344255", "size": 16, "haloColor": "#FFFFFF", "haloWidth": 1.5}
          }
        },
        "roads": {
          "primary": {"text": {"color": "#566476", "size": 12}}
        },
        "water": {
          "ocean": {"text": {"color": "#397C96", "size": 14}}
        }
      }
    },
    "land": {
      "type": "land",
      "background": {"color": "#F7F7F5"},
      "globalLandcover": {"opacity": 0.75, "maxZoom": 8},
      "landcover": {
        "grass": {"fill": {"color": "#D8EBD3"}},
        "sand": {"fill": {"color": "#F1E6C8"}},
        "wood": {"fill": {"color": "#C8E0C5"}}
      },
      "landuse": {
        "commercial": {"fill": {"color": "#F2E8DD"}},
        "industrial": {"fill": {"color": "#ECE8E4"}},
        "residential": {"fill": {"color": "#F1F1EF"}}
      }
    },
    "landforms": {
      "type": "landforms",
      "elevation": true,
      "classes": {
        "peak": {"text": {"color": "#655849", "size": 12}},
        "volcano": {"marker": {"color": "#9B665E", "radius": 3}}
      }
    },
    "poi": {
      "type": "poi",
      "preset": "balanced",
      "categories": ["food", "culture", "health", "transit"],
      "color": "category",
      "density": "balanced",
      "icons": false,
      "labels": "balanced",
      "maxRank": {
        "kind": "zoom",
        "interpolation": "step",
        "stops": [
          [13, 14],
          [16, 80],
          [19, 500]
        ]
      },
      "placement": {"coupleIconAndLabel": true, "iconPadding": 2, "textPadding": 2},
      "styles": {
        "food": {"maxRank": 80, "text": {"color": "#B45E3B"}},
        "culture": {"maxRank": 60, "marker": {"color": "#7955A8", "radius": 3}}
      }
    },
    "roads": {
      "type": "roads",
      "detail": "all",
      "hierarchy": "clear",
      "weight": "regular",
      "outline": "strong",
      "oneWayMarkers": true,
      "extras": {"paths": true},
      "classes": {
        "primary": {
          "surface": {
            "casing": {"color": "#FFFFFF", "width": 10},
            "fill": {
              "color": "#AFC0D1",
              "width": {
                "kind": "zoom",
                "interpolation": "linear",
                "stops": [
                  [8, 1],
                  [16, 8]
                ]
              }
            }
          }
        },
        "footway": {"surface": {"fill": {"color": "#D9E1E5", "width": 1.2}}}
      },
      "areas": {
        "pedestrian": {"fill": {"color": "#F2F3F4"}}
      },
      "modifiers": {
        "construction": {"surface": {"fill": {"dash": [2, 1], "opacity": 0.7}}},
        "unpaved": {"surface": {"fill": {"color": "#DED3C1"}}}
      },
      "serviceTypes": {
        "driveway": {"widthScale": 0.75},
        "parkingAisle": {"widthScale": 0.6}
      },
      "sidewalks": {
        "surface": {"color": "#F8F8F6", "minZoom": 17}
      },
      "roundabouts": {
        "casing": {"strokeColor": "#FFFFFF"},
        "fill": {"strokeColor": "#AFC0D1"}
      }
    },
    "transit": {
      "type": "transit",
      "ferry": {"color": "#6EAFCB", "dash": [3, 2], "width": 1.5},
      "rail": {
        "surface": {"color": "#87929D", "width": 1.2},
        "tunnel": {"color": "#AEB6BE", "dash": [2, 2]},
        "bridge": {"color": "#6F7B86", "width": 1.4}
      }
    },
    "vegetation": {
      "type": "vegetation",
      "mode": "3d",
      "flat": {"color": "#6E9E72", "radius": 3, "minZoom": 16},
      "threeDimensional": {
        "barkColor": "#8A755F",
        "broadleafColors": ["#6E9E72", "#82AD7D"],
        "coniferColors": ["#47785B", "#5D8B68"],
        "heightScale": 1,
        "crownScale": 1
      }
    },
    "water": {
      "type": "water",
      "bathymetry": {"opacity": 0.7, "maxZoom": 10},
      "bodies": {"fill": {"color": "#A8D8EF"}},
      "intermittent": {
        "bodies": {"fill": {"color": "#A8D8EF", "opacity": 0.65}},
        "waterways": {"color": "#72BDD8", "dash": [2, 1]}
      },
      "waterways": {
        "canal": {"color": "#72BDD8", "width": 1.2},
        "river": {"color": "#72BDD8", "width": 2.5},
        "stream": {"color": "#72BDD8", "width": 1}
      }
    }
  }
}
