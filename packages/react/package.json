{
  "name": "@tileflow/react",
  "version": "0.0.0-development",
  "license": "Apache-2.0",
  "description": "React components for rendering Tileflow maps with MapLibre.",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://tileflow.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tileflow/tileflow-sdk.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/tileflow/tileflow-sdk/issues"
  },
  "keywords": [
    "tileflow",
    "react",
    "maps",
    "maplibre",
    "tiles"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node ../../scripts/package-license.mjs --prepare",
    "postpack": "node ../../scripts/package-license.mjs --clean",
    "build": "tsup",
    "verify": "pnpm run build && tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.contract.json",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./static": {
      "types": "./dist/static.d.ts",
      "import": "./dist/static.js",
      "default": "./dist/static.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@tileflow/core": "workspace:>=0.1.0-alpha.16 <0.1.0-beta.0",
    "@tileflow/interactions": "workspace:>=0.1.0-alpha.16 <0.1.0-beta.0",
    "@tileflow/static": "workspace:>=0.1.0-alpha.16 <0.1.0-beta.0"
  },
  "peerDependencies": {
    "maplibre-gl": ">=6.4.1 <7",
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.7",
    "maplibre-gl": "6.9.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.8"
  }
}
