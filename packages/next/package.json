{
  "name": "@tileflow/next",
  "version": "0.0.0-development",
  "license": "Apache-2.0",
  "description": "Next.js adapter for Tileflow map style development and static artifacts.",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "homepage": "https://tileflow.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tileflow/tileflow-sdk.git",
    "directory": "packages/next"
  },
  "bugs": {
    "url": "https://github.com/tileflow/tileflow-sdk/issues"
  },
  "keywords": [
    "tileflow",
    "nextjs",
    "next",
    "maps",
    "maplibre",
    "adapter"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "GENERATED_OUTPUT_LICENSE.md",
    "TRADEMARKS.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/server.ts --format esm --dts --clean --external next --platform node",
    "verify": "pnpm run build && tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@tileflow/dev": "workspace:>=0.1.0-alpha.16 <0.1.0-beta.0"
  },
  "peerDependencies": {
    "next": ">=14 <17"
  },
  "devDependencies": {
    "@tileflow/maps": "workspace:*",
    "next": "16.3.1"
  }
}
