{
  "name": "@tileflow/webpack",
  "version": "0.0.0-development",
  "license": "Apache-2.0",
  "description": "Webpack plugin for Tileflow map style development and static artifacts.",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "homepage": "https://tileflow.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tileflow/tileflow-sdk.git",
    "directory": "packages/webpack"
  },
  "bugs": {
    "url": "https://github.com/tileflow/tileflow-sdk/issues"
  },
  "keywords": [
    "tileflow",
    "webpack",
    "maps",
    "maplibre",
    "plugin"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "GENERATED_OUTPUT_LICENSE.md",
    "TRADEMARKS.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --platform node",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "verify": "pnpm run typecheck && pnpm run test"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@tileflow/dev": "workspace:>=0.1.0-alpha.16 <0.1.0-beta.0"
  },
  "devDependencies": {
    "@tileflow/maps": "workspace:*"
  },
  "peerDependencies": {
    "webpack": ">=5.61 <6"
  }
}
