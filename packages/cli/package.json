{
  "name": "@tileflow/cli",
  "version": "0.0.0-development",
  "license": "Apache-2.0",
  "description": "CLI-only tools for Tileflow config, capture, visual testing, and deploy.",
  "type": "module",
  "homepage": "https://tileflow.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tileflow/tileflow-sdk.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/tileflow/tileflow-sdk/issues"
  },
  "keywords": [
    "tileflow",
    "cli",
    "maps",
    "maplibre",
    "tiles"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "GENERATED_OUTPUT_LICENSE.md",
    "TRADEMARKS.md"
  ],
  "bin": {
    "tileflow": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --no-splitting --platform node",
    "cli": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "verify": "pnpm run typecheck && pnpm run test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hono/node-server": "2.0.10",
    "@tileflow/capture": "workspace:>=0.1.0-alpha.16 <0.1.0-beta.0",
    "@tileflow/core": "workspace:>=0.1.0-alpha.16 <0.1.0-beta.0",
    "@tileflow/dev": "workspace:>=0.1.0-alpha.16 <0.1.0-beta.0",
    "@tileflow/maps": "workspace:>=0.1.0-alpha.16 <0.1.0-beta.0",
    "hono": "4.12.34",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pngjs": "6.0.5",
    "pngjs": "7.0.0"
  }
}
