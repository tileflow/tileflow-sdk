{
  "id": "complete-example",
  "name": "Complete Tileflow theme example",
  "version": 1,
  "root": {"compiler": "streets", "compilerVersion": 1},
  "glyphs": {
    "kind": "url",
    "url": "https://cdn.example.com/glyphs/v1/{fontstack}/{range}.pbf",
    "fontStacks": ["Noto Sans Regular", "Noto Sans Bold"]
  },
  "icons": [],
  "themes": {
    "light": {
      "id": "complete-example-light",
      "version": 1,
      "colorScheme": "light",
      "tokens": {
        "color": {
          "boundaries.default": "#C9D1D9",
          "labels.halo": "#FFFFFF",
          "labels.muted": "#727B84",
          "labels.primary": "#3C4043",
          "roads.casing": "#CBD1D8",
          "roads.default": "#FFFFFF",
          "roads.major": "#F4C95D",
          "roads.primary": "#F4C95D",
          "surface.background": "#F6F7F3",
          "surface.building": "#E6E3DA",
          "surface.land": "#F1F3ED",
          "surface.park": "#CDE8B5",
          "surface.water": "#A9D3F5"
        },
        "font": {
          "default": "Noto Sans Regular",
          "places": "Noto Sans Bold"
        },
        "image": {},
        "number": {}
      },
      "typography": {
        "font": {"kind": "theme-token", "category": "font", "token": "default"},
        "places": {
          "font": {"kind": "theme-token", "category": "font", "token": "places"}
        }
      },
      "lighting": {
        "anchor": "viewport",
        "color": "#FFFFFF",
        "intensity": 0.15,
        "position": [1.15, 210, 30]
      }
    },
    "dark": {
      "id": "complete-example-dark",
      "version": 1,
      "colorScheme": "dark",
      "tokens": {
        "color": {
          "boundaries.default": "#526174",
          "labels.halo": "#0B1220",
          "labels.muted": "#9AA9B8",
          "labels.primary": "#CBD5E1",
          "roads.casing": "#263449",
          "roads.default": "#45536A",
          "roads.major": "#61738E",
          "roads.primary": "#61738E",
          "surface.background": "#0B1220",
          "surface.building": "#202B3A",
          "surface.land": "#151E2D",
          "surface.park": "#20382B",
          "surface.water": "#10324B"
        },
        "font": {
          "default": "Noto Sans Regular",
          "places": "Noto Sans Bold"
        },
        "image": {},
        "number": {}
      },
      "typography": {
        "font": {"kind": "theme-token", "category": "font", "token": "default"},
        "places": {
          "font": {"kind": "theme-token", "category": "font", "token": "places"}
        }
      },
      "lighting": {
        "anchor": "viewport",
        "color": "#9FB6D0",
        "intensity": 0.08,
        "position": [1.15, 210, 30]
      }
    }
  },
  "defaultTheme": "light",
  "systemThemes": {"light": "light", "dark": "dark"},
  "projection": "globe",
  "terrain": "none",
  "view": {
    "center": [-3.7038, 40.4168],
    "zoom": 13,
    "pitch": 35,
    "bearing": 0
  },
  "scenes": {
    "madrid-desktop": {
      "theme": "dark",
      "camera": {
        "type": "center",
        "center": [-3.7038, 40.4168],
        "zoom": 13,
        "pitch": 35,
        "bearing": 0
      },
      "viewport": {"width": 1280, "height": 800, "dpr": 1}
    }
  },
  "modules": {
    "land": {
      "type": "land",
      "background": {
        "color": {
          "kind": "theme-token",
          "category": "color",
          "token": "surface.background"
        }
      }
    },
    "water": {
      "type": "water",
      "bodies": {
        "fill": {
          "color": {
            "kind": "theme-token",
            "category": "color",
            "token": "surface.water"
          },
          "opacity": {
            "kind": "theme-fixed",
            "reason": "Water density remains invariant across this map's themes",
            "value": 0.96
          }
        }
      }
    },
    "roads": {
      "type": "roads",
      "detail": "streets",
      "hierarchy": "clear",
      "classes": {
        "primary": {
          "surface": {
            "casing": {
              "color": {
                "kind": "theme-token",
                "category": "color",
                "token": "roads.casing"
              },
              "width": {
                "kind": "theme-fixed",
                "reason": "Primary-road casing hierarchy remains invariant across themes",
                "value": 8
              }
            },
            "fill": {
              "color": {
                "kind": "theme-token",
                "category": "color",
                "token": "roads.primary"
              },
              "width": {
                "kind": "theme-fixed",
                "reason": "Primary-road width remains invariant across themes",
                "value": 6
              }
            }
          }
        }
      }
    },
    "labels": {
      "type": "labels",
      "places": "all",
      "roads": "major",
      "styles": {
        "places": {
          "city": {
            "text": {
              "color": {
                "kind": "theme-token",
                "category": "color",
                "token": "labels.primary"
              },
              "font": {
                "kind": "theme-token",
                "category": "font",
                "token": "places"
              },
              "haloColor": {
                "kind": "theme-token",
                "category": "color",
                "token": "labels.halo"
              },
              "haloWidth": {
                "kind": "theme-fixed",
                "reason": "City-label halo remains invariant across themes",
                "value": 1.5
              },
              "size": {
                "kind": "theme-fixed",
                "reason": "City-label hierarchy remains invariant across themes",
                "value": 16
              }
            }
          }
        }
      }
    },
    "poi": {
      "type": "poi",
      "density": 2,
      "icons": false
    }
  }
}
