    "day": {
      "version": 8,
      "name": "day",
      "light": {
        "anchor": "map",
        "color": "#ffffff",
        "intensity": 0.4
      },
      "sources": {
        "world": {
          "type": "vector",
          "url": "https://example.com/world.json"
        }
      },
      "layers": [
        {
          "id": "background",
          "type": "background",
          "paint": {
            "background-color": "#f4f0ef"
          },
          "metadata": {
            "tileflow:domain": "land"
          }
        },
        {
          "id": "landcover",
          "type": "fill",
          "source": "world",
          "source-layer": "landcover",
          "paint": {
            "fill-color": [
              "match",
              ["get", "class"],
              "grass",
              "#cfe3b4",
              "wood",
              "#a9c98f",
              "#e6e2d8"
            ],
            "fill-opacity": 0.9
          },
          "metadata": {
            "tileflow:domain": "land"
          }
        },
        {
          "id": "water",
          "type": "fill",
          "source": "world",
          "source-layer": "water",
          "paint": {
            "fill-pattern": "water-day",
            "fill-opacity": 1
          },
          "metadata": {
            "tileflow:domain": "water"
          }
        },
        {
          "id": "roads",
          "type": "line",
          "source": "world",
          "source-layer": "transportation",
          "paint": {
            "line-color": ["interpolate", ["linear"], ["zoom"], 10, "#f2d9a6", 16, "#ffffff"],
            "line-opacity": ["interpolate", ["linear"], ["zoom"], 10, 0.45, 16, 1],
            "line-width": 2
          },
          "metadata": {
            "tileflow:domain": "roads"
          }
        },
        {
          "id": "places",
          "type": "circle",
          "source": "world",
          "source-layer": "poi",
          "paint": {
            "circle-radius": ["*", ["get", "rank"], 2],
            "circle-color": "#ffffff"
          },
          "metadata": {
            "tileflow:domain": "poi"
          }
        },
        {
          "id": "labels",
          "type": "symbol",
          "source": "world",
          "source-layer": "place",
          "layout": {
            "text-field": ["get", "name"],
            "icon-image": "pin-day"
          },
          "paint": {
            "text-color": "#1f2933",
            "text-halo-color": "#ffffff",
            "text-opacity": 1
          },
          "metadata": {
            "tileflow:domain": "labels"
          }
        }
      ],
      "metadata": {
        "tileflow:colorScheme": "light",
        "tileflow:sun": {
          "version": 1,
          "azimuth": 350,
          "altitude": 60,
          "color": "#ffffff",
          "intensity": 0.5,
          "shadowIntensity": 0.6,
          "ambient": {
            "color": "#dfe8ff",
            "intensity": 0.5
          }
        },
        "tileflow:route": {
          "version": 1,
          "line": "#2563eb",
          "casing": "#1e3a8a",
          "core": "#eff6ff",
          "glow": "#2563eb",
          "alternative": "#64748b",
          "glowOpacity": 0.16,
          "coreOpacity": 0
        },
        "tileflow:notices": [
          {
            "id": "not-for-navigation",
            "sources": ["world"],
            "text": "Not for navigation"
          }
        ],
        "tileflow:nativeDegradations": [
          {
            "id": "globe",
            "feature": "globe",
            "reason": "engine-unsupported",
            "fallback": "mercator",
            "layers": []
          }
        ]
      }
