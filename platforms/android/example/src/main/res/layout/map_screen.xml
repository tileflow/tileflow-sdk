<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <!-- The map fills the window; the panel covers its bottom and becomes content padding. -->
    <dev.tileflow.sdk.TileflowMapView android:id="@+id/map"
        android:layout_width="match_parent" android:layout_height="match_parent" />
    <LinearLayout android:id="@+id/panel" android:orientation="vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:background="#F2FFFFFF" android:padding="16dp">
        <TextView android:id="@+id/status" android:text="Loading Tileflow…"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/theme" android:text="Change theme"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/myLocation" android:text="My location"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
</FrameLayout>
