{
  "name": "tileflow",
  "version": "0.0.0-development",
  "license": "Apache-2.0",
  "description": "CLI-only tools for Tileflow config, capture, visual testing, tiling, and deploy.",
  "type": "module",
  "homepage": "https://tileflow.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tileflow/tileflow-sdk.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/tileflow/tileflow-sdk/issues"
  },
  "keywords": [
    "tileflow",
    "cli",
    "maps",
    "maplibre",
    "tiles"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "schemas",
    "REFERENCE.md",
    "LICENSE"
  ],
  "bin": {
    "tileflow": "./dist/index.js"
  },
  "scripts": {
    "prepack": "node ../../scripts/package-license.mjs --prepare",
    "postpack": "node ../../scripts/package-license.mjs --clean",
    "build": "tsup src/index.ts --format esm --clean --splitting --platform node",
    "cli": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=2 test/*.test.ts",
    "verify": "pnpm run typecheck && pnpm run test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@tileflow/capture": "workspace:>=0.1.0-alpha.16 <0.1.0-beta.0",
    "@tileflow/coordinates": "workspace:>=0.1.0-alpha.16 <0.1.0-beta.0",
    "@tileflow/coordinates-runtime": "workspace:>=0.1.0-alpha.16 <0.1.0-beta.0",
    "@tileflow/core": "workspace:>=0.1.0-alpha.16 <0.1.0-beta.0",
    "@tileflow/dev": "workspace:>=0.1.0-alpha.16 <0.1.0-beta.0",
    "@tileflow/maps": "workspace:>=0.1.0-alpha.16 <0.1.0-beta.0",
    "@tileflow/search": "workspace:>=0.1.0-alpha.16 <0.1.0-beta.0",
    "commander": "^15.0.0",
    "fflate": "0.8.3",
    "hono": "4.13.14",
    "picocolors": "^1.1.1",
    "pmtiles": "4.5.0",
    "proj4": "2.22.0",
    "yauzl": "3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "3.0.0",
    "@types/pngjs": "6.0.5",
    "@types/yauzl": "3.4.0",
    "pbf": "5.1.2",
    "pngjs": "7.0.0"
  }
}
