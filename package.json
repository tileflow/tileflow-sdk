{
  "name": "tileflow-sdk",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Public SDK packages and CLI for Tileflow.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tileflow/tileflow-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/tileflow/tileflow-sdk/issues"
  },
  "homepage": "https://tileflow.dev/docs",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo build",
    "build:packages": "turbo build --filter='./packages/*'",
    "check": "pnpm run legal:check && pnpm run reference:check && pnpm run test:release && pnpm run test:architecture && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run verify",
    "typecheck": "turbo typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "legal:check": "node scripts/sync-package-legal-files.mjs --check",
    "legal:sync": "node scripts/sync-package-legal-files.mjs --write",
    "test:release": "node --test scripts/compare-package-tarballs.test.mjs scripts/create-release-receipt.test.mjs scripts/public-release-interlock.test.mjs scripts/publication-decision.test.mjs scripts/reconcile-release.test.mjs scripts/release-config.test.mjs scripts/release-workflow.test.mjs scripts/run-command.test.mjs scripts/select-release-tarballs.test.mjs scripts/wait-for-published-packages.test.mjs",
    "test:architecture": "node --test scripts/sdk-boundaries.test.mjs",
    "verify": "pnpm -r --workspace-concurrency=1 --if-present run verify",
    "format": "prettier --plugin=prettier-plugin-svelte --write .",
    "format:check": "prettier --plugin=prettier-plugin-svelte --check .",
    "fix": "prettier --plugin=prettier-plugin-svelte --write . && eslint --fix .",
    "reference:check": "pnpm --filter @tileflow/core reference:check",
    "reference:generate": "pnpm --filter @tileflow/core reference:generate",
    "release:verify-source": "node scripts/reconcile-release.mjs validate-source",
    "smoke:capture-public": "node scripts/capture-public-smoke.mjs",
    "smoke:peer-compat": "node scripts/peer-compat-smoke.mjs",
    "publish:alpha:dry-run": "pnpm run release:verify-source && pnpm run build:packages && pnpm run check && pnpm run smoke:capture-public"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^25.9.2",
    "ajv": "8.20.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.9.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.2",
    "semver": "7.8.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "turbo": "^2.10.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
