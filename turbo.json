{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["pnpm_config_verify_deps_before_run"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@tileflow/svelte#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@tileflow/mobile-runtime#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/mobile-runtime-build.mjs",
        "$TURBO_ROOT$/scripts/mobile-runtime-notices.mjs",
        "$TURBO_ROOT$/LICENSE"
      ],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    }
  }
}
