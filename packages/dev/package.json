{
  "name": "@tileflow/dev",
  "version": "0.0.0-development",
  "license": "Apache-2.0",
  "description": "Node development utilities for Tileflow configs and builds.",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://tileflow.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tileflow/tileflow-sdk.git",
    "directory": "packages/dev"
  },
  "bugs": {
    "url": "https://github.com/tileflow/tileflow-sdk/issues"
  },
  "keywords": [
    "tileflow",
    "maps",
    "maplibre",
    "development",
    "styles"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "NOTICE",
    "GENERATED_OUTPUT_LICENSE.md",
    "TRADEMARKS.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/artifacts.ts src/config.ts src/fonts.ts src/icons.ts src/inspect.ts src/preview.ts src/server.ts src/tilesets.ts src/validation.ts --format esm --dts --clean --platform node --external sharp",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "verify": "pnpm run typecheck && pnpm run test"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./artifacts": {
      "types": "./dist/artifacts.d.ts",
      "import": "./dist/artifacts.js",
      "default": "./dist/artifacts.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js",
      "default": "./dist/icons.js"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "import": "./dist/fonts.js",
      "default": "./dist/fonts.js"
    },
    "./inspect": {
      "types": "./dist/inspect.d.ts",
      "import": "./dist/inspect.js",
      "default": "./dist/inspect.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js",
      "default": "./dist/preview.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./tilesets": {
      "types": "./dist/tilesets.d.ts",
      "import": "./dist/tilesets.js",
      "default": "./dist/tilesets.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js",
      "default": "./dist/validation.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@mapbox/vector-tile": "2.0.5",
    "@maplibre/maplibre-gl-style-spec": "24.8.5",
    "@tileflow/core": "workspace:>=0.1.0-alpha.16 <0.1.0-beta.0",
    "chokidar": "4.0.3",
    "fflate": "0.8.3",
    "fontkit": "2.0.4",
    "jiti": "^2.7.0",
    "maplibre-gl": "5.24.0",
    "pbf": "5.1.2",
    "pmtiles": "4.5.0",
    "saxes": "6.0.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@tileflow/maps": "workspace:*"
  },
  "optionalDependencies": {
    "sharp": "0.35.3"
  }
}
