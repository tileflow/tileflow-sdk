{
  "name": "@tileflow/elevation",
  "version": "0.0.0-development",
  "license": "Apache-2.0",
  "description": "Point heights, elevation profiles and a MapLibre elevation profile control for Tileflow.",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://tileflow.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tileflow/tileflow-sdk.git",
    "directory": "packages/elevation"
  },
  "bugs": {
    "url": "https://github.com/tileflow/tileflow-sdk/issues"
  },
  "keywords": [
    "tileflow",
    "maps",
    "elevation",
    "elevation-profile",
    "terrain",
    "dem",
    "gpx",
    "maplibre"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node ../../scripts/package-license.mjs --prepare",
    "postpack": "node ../../scripts/package-license.mjs --clean",
    "build": "tsup src/index.ts src/contract.ts src/client.ts src/profile-entry.ts src/maplibre-entry.ts --format esm --dts --clean --splitting && node ../../scripts/canonicalize-zod-enums.mjs dist",
    "verify": "pnpm run build && tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js",
      "default": "./dist/contract.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./profile": {
      "types": "./dist/profile-entry.d.ts",
      "import": "./dist/profile-entry.js",
      "default": "./dist/profile-entry.js"
    },
    "./maplibre": {
      "types": "./dist/maplibre-entry.d.ts",
      "import": "./dist/maplibre-entry.js",
      "default": "./dist/maplibre-entry.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "maplibre-gl": "6.13.0"
  }
}
