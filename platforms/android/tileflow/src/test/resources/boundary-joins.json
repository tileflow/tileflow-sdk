    {
      "name": "numeric IDs normalize to safe integers, with stable last-wins order",
      "rows": [
        {"key": " 0x2A ", "value": 1},
        {"key": 3, "value": "three"},
        {"key": "﻿0b101010﻿", "value": null},
        {"key": "0o52", "value": "last"},
        {"key": ".3e1", "value": 4},
        {"key": 9007199254740991, "value": 5},
        {"key": "9007199254740992", "value": 6},
        {"key": 9007199254740992, "value": 7},
        {"key": -1, "value": 8},
        {"key": 1.25, "value": 9},
        {"key": "0x1p0", "value": 10},
        {"key": "1d", "value": 11},
        {"key": " ", "value": 12},
        {"key": "-0", "value": 13}
      ],
      "options": {"joinBy": "id"},
      "expected": {
        "ambiguous": [],
        "duplicates": [42, 3],
        "joinBy": "id",
        "rows": [
          {"key": 42, "value": "last"},
          {"key": 3, "value": 4},
          {"key": 9007199254740991, "value": 5},
          {"key": 0, "value": 13}
        ],
